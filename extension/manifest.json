{
  "manifest_version": 3,
  "name": "FormPilot",
  "version": "1.0.0",
  "description": "Fill supported forms using your profile stored locally in the browser.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "scripts": ["shared/storage.js", "background.js"],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "121.0"
    }
  },
  "action": {},
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
